# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# Riot developer key from https://developer.riotgames.com/
# Personal dev keys expire every 24 hours; regenerate before a collection run.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The encrypted PUUID of the account to track. Look it up via the account-v1
# endpoint: /riot/account/v1/accounts/by-riot-id/{gameName}/{tagLine}
PUUID=

# postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/leaguetracker
